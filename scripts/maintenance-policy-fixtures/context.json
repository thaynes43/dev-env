{
  "apiVersion": "cli.kyverno.io/v1alpha1",
  "kind": "Context",
  "metadata": {
    "name": "synthetic"
  },
  "spec": {
    "resources": [
      {
        "apiVersion": "dev-env.haynesops.com/v1alpha1",
        "kind": "AccessGrant",
        "metadata": {
          "namespace": "dev-agents",
          "name": "grant-synthetic",
          "uid": "11111111-2222-3333-4444-555555555555"
        },
        "spec": {
          "type": "maintenance",
          "maintenance": {
            "runtimeProfile": "nvidia-utility",
            "resource": "GPU-00000000-0000-0000-0000-000000000001",
            "node": "synthetic-node",
            "nodeUID": "22222222-2222-3333-4444-555555555555",
            "image": "ghcr.io/example/tool@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "capabilities": [
              "SYS_ADMIN"
            ],
            "cpuMillis": 100,
            "memoryMiB": 128
          }
        },
        "status": {
          "phase": "Active"
        }
      },
      {
        "apiVersion": "v1",
        "kind": "Node",
        "metadata": {
          "name": "synthetic-node",
          "uid": "22222222-2222-3333-4444-555555555555"
        },
        "spec": {}
      },
      {
        "apiVersion": "v1",
        "kind": "Pod",
        "metadata": {
          "name": "grant-synthetic",
          "namespace": "dev-agents",
          "labels": {
            "dev-env.haynesops.com/maintenance": "11111111-2222-3333-4444-555555555555",
            "dev-env.haynesops.com/grant": "grant-synthetic"
          },
          "ownerReferences": [
            {
              "apiVersion": "dev-env.haynesops.com/v1alpha1",
              "kind": "AccessGrant",
              "name": "grant-synthetic",
              "uid": "11111111-2222-3333-4444-555555555555",
              "controller": true
            }
          ]
        },
        "spec": {
          "nodeName": "synthetic-node",
          "serviceAccountName": "dev-env-maintenance",
          "automountServiceAccountToken": false,
          "runtimeClassName": "nvidia",
          "restartPolicy": "Never",
          "enableServiceLinks": false,
          "activeDeadlineSeconds": 1800,
          "terminationGracePeriodSeconds": 10,
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "containers": [
            {
              "name": "maintenance",
              "image": "ghcr.io/example/tool@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "command": [
                "/bin/sleep",
                "infinity"
              ],
              "env": [
                {
                  "name": "NVIDIA_VISIBLE_DEVICES",
                  "value": "GPU-00000000-0000-0000-0000-000000000001"
                },
                {
                  "name": "NVIDIA_DRIVER_CAPABILITIES",
                  "value": "utility"
                }
              ],
              "securityContext": {
                "privileged": false,
                "allowPrivilegeEscalation": false,
                "readOnlyRootFilesystem": true,
                "runAsUser": 0,
                "capabilities": {
                  "drop": [
                    "ALL"
                  ],
                  "add": [
                    "SYS_ADMIN"
                  ]
                }
              },
              "resources": {
                "requests": {
                  "cpu": "100m",
                  "memory": "128Mi"
                },
                "limits": {
                  "cpu": "100m",
                  "memory": "128Mi"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
